{
  "name": "aic",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "All-in-One Class — password-gated local-first classroom boards, PDF worksheets, games, screen sharing and focus monitoring.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "wrangler dev --port 8787 --local",
    "dev:web": "vite",
    "dev:lan": "concurrently -k -n api,web -c blue,magenta \"bun run dev:api\" \"vite --port 8000\"",
    "dev:https": "vite --config vite.https.config.ts",
    "cert:lan": "bash scripts/make-lan-cert.sh",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "preview": "vite preview",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250900.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.30.0"
  }
}
